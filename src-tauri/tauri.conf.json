{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "clientcontroller",
    "version":  "0.1.3",
    "identifier":  "de.followflow.clientcontroller",
    "build":  {
                  "beforeDevCommand":  "npm run prepare:workflow-runtime && npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run install:workflow-runtime && npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "clientcontroller",
                                    "width":  800,
                                    "height":  600
                                }
                            ],
                "security":  {
                                 "csp":  {
                                             "default-src":  "'self'",
                                             "connect-src":  "ipc: http://ipc.localhost",
                                             "font-src":  "'self'",
                                             "img-src":  "'self' data: blob:",
                                             "style-src":  "'self' 'unsafe-inline'",
                                             "script-src":  "'self'",
                                             "object-src":  "'none'",
                                             "base-uri":  "'none'",
                                             "frame-ancestors":  "'none'",
                                             "form-action":  "'none'"
                                         },
                                 "devCsp":  {
                                                "default-src":  "'self' http://localhost:1420",
                                                "connect-src":  "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
                                                "font-src":  "'self'",
                                                "img-src":  "'self' data: blob:",
                                                "style-src":  "'self' 'unsafe-inline'",
                                                "script-src":  "'self' http://localhost:1420",
                                                "object-src":  "'none'",
                                                "base-uri":  "'none'",
                                                "frame-ancestors":  "'none'",
                                                "form-action":  "'none'"
                                            },
                                 "headers":  {
                                                 "X-Content-Type-Options":  "nosniff",
                                                 "Permissions-Policy":  "camera=(), microphone=(), geolocation=()"
                                             }
                             }
            },
    "plugins":  {},
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "createUpdaterArtifacts":  false,
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "resources/platform-tools/**/*",
                                     "resources/drivers/**/*",
                                     "resources/workflow-runtime/**/*"
                                 ]
               }
}
